# Firebase configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# To use environment variables in React Native, install react-native-config:
#   npm install react-native-config
# and follow the setup guide at https://github.com/luggit/react-native-config
#
# Then update lib/firebase.js to read values from Config instead of hard-coding them.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
